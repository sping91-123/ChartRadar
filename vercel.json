{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "src/app/api/crypto-home-snapshot/route.ts": {
      "regions": ["icn1"]
    },
    "src/app/api/crypto-home-ticker/route.ts": {
      "regions": ["icn1"]
    },
    "src/app/api/liquidation-pressure/route.ts": {
      "regions": ["icn1"]
    },
    "src/app/api/large-trade-flow/route.ts": {
      "regions": ["icn1"]
    },
    "src/app/api/crypto/perpetual/snapshot/route.ts": {
      "regions": ["sin1"]
    },
    "src/app/api/crypto/perpetual/monitors/route.ts": {
      "regions": ["sin1"]
    },
    "src/app/api/push-cron/route.ts": {
      "regions": ["sin1"]
    },
    "src/app/api/macro-sync/route.ts": {
      "regions": ["icn1"]
    },
    "src/app/api/news-sync/route.ts": {
      "regions": ["sin1"]
    },
    "src/app/api/exchange-connections/route.ts": {
      "regions": ["sin1"]
    },
    "src/app/api/exchange-connections/[id]/sync/route.ts": {
      "regions": ["sin1"]
    },
    "src/app/api/exchange-sync/route.ts": {
      "regions": ["sin1"],
      "maxDuration": 240
    }
  },
  "crons": [
    {
      "path": "/api/rapid-move-cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/push-cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/macro-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/news-sync",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/account-deletions/process",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/exchange-sync",
      "schedule": "*/5 * * * *"
    }
  ]
}
