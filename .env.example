NEXT_PUBLIC_SITE_URL=https://your-domain.kr

# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Google OAuth web client ID for web GIS and Android native Google Sign-In.
# Android also needs a separate Google Cloud Android OAuth client with package name and SHA-1.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Kakao REST API key for direct Kakao authorization code login.
NEXT_PUBLIC_KAKAO_REST_API_KEY=
# Optional. Leave empty unless Kakao consent items are enabled.
NEXT_PUBLIC_KAKAO_AUTH_SCOPE=
# Server-only. Required when Kakao REST API client secret is enabled.
KAKAO_CLIENT_SECRET=
# Server-only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=
# Stores the Supabase refresh token in browser/WebView localStorage so login and Pro entitlement survive app restarts.
# Keep true until a cookie-backed or Capacitor secure-storage session store replaces this client storage.
NEXT_PUBLIC_ALLOW_LOCAL_REFRESH_TOKEN=true

# Optional. Web checkout links by product.
NEXT_PUBLIC_PRO_PAYMENT_URL=
NEXT_PUBLIC_PRO_MONTHLY_PAYMENT_URL=
NEXT_PUBLIC_PRO_YEARLY_PAYMENT_URL=
NEXT_PUBLIC_CRYPTO_MONTHLY_PAYMENT_URL=
NEXT_PUBLIC_CRYPTO_YEARLY_PAYMENT_URL=
NEXT_PUBLIC_GLOBAL_MONTHLY_PAYMENT_URL=
NEXT_PUBLIC_GLOBAL_YEARLY_PAYMENT_URL=
NEXT_PUBLIC_STOCKS_MONTHLY_PAYMENT_URL=
NEXT_PUBLIC_STOCKS_YEARLY_PAYMENT_URL=
NEXT_PUBLIC_BUNDLE_MONTHLY_PAYMENT_URL=
NEXT_PUBLIC_BUNDLE_6MONTH_PAYMENT_URL=

# Optional. TossPayments direct checkout keys.
# Keep the secret key server-side only.
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=

NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=
REVENUECAT_REST_API_KEY=
REVENUECAT_WEBHOOK_SIGNING_SECRET=

# Server-only Apple Sign in credentials and token-at-rest encryption.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=com.staronlabs.chartradar
APPLE_PRIVATE_KEY=
# Generate exactly 32 random bytes and encode them as base64.
APPLE_TOKEN_ENCRYPTION_KEY=
ACCOUNT_DELETION_PROCESSING_ENABLED=false

# Server-only read-only exchange journal. Keep off until the production migration,
# encryption key, and provider reconciliation have been approved.
EXCHANGE_JOURNAL_V1=off
# Required before EXCHANGE_JOURNAL_V1=on. Use canary with an explicit user allowlist first.
EXCHANGE_CONNECTION_ROLLOUT=locked
EXCHANGE_CONNECTION_CANARY_USER_IDS=
EXCHANGE_OKX_ENABLED=false
EXCHANGE_BYBIT_ENABLED=false
EXCHANGE_BITGET_ENABLED=false
EXCHANGE_BINGX_ENABLED=false
# LBank remains unavailable in v1 even when this value is set.
EXCHANGE_LBANK_ENABLED=false
# Optional defense in depth. Leave empty when API keys do not use an IP allowlist.
# When set, use exactly two unique Production Static IPv4 addresses.
EXCHANGE_SYNC_EGRESS_IPS=
# Scheduled sync claims at most 25 connections and runs at most 8 concurrently.
EXCHANGE_SYNC_BATCH_SIZE=8
EXCHANGE_SYNC_CONCURRENCY=4
# Generate exactly 32 random bytes and encode them as base64.
# This key must be different from APPLE_TOKEN_ENCRYPTION_KEY.
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY_V1=

# Optional. AI providers. Groq is the default production provider.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GEMINI_API_KEY=
# Optional. Keep false/empty unless you intentionally accept Gemini API costs after Groq fails.
ENABLE_GEMINI_AI_FALLBACK=
# Optional. Keep empty for faster local title cleanup. Set to mymemory only if you accept slower free translation calls.
NEWS_TRANSLATION_PROVIDER=
# Optional. Groq is preferred. Set true only when Gemini should be tried after Groq fails.
ENABLE_GEMINI_NEWS_FALLBACK=
# Optional server-only live FX provider. Without it, the app uses an hourly
# no-key reference rate and clearly labels any daily fallback.
EXCHANGE_RATE_DEV_API_KEY=

# Optional. Production API rate limit storage.
# Local development falls back to memory when these are empty.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace's Upstash integration injects these aliases instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Hard global ceiling for new provider-backed Perpetual AI explanations per 24-hour window.
PERPETUAL_AI_DAILY_PROVIDER_LIMIT=240

# Optional. Mobile shell target URL.
CAPACITOR_SERVER_URL=https://your-domain.kr

# Server-only. Required for Vercel Cron protected automatic Android app push.
CRON_SECRET=
PERPETUAL_REVENUE_CORE_V1=shadow
# News Impact stores official events and reactions in shadow mode until Gate B.
NEWS_IMPACT_V1=shadow
# Keep actual news Push disabled until Gate C is approved and verified.
NEWS_IMPACT_PUSH_ENABLED=false
# Identifiable server-only User-Agent used for SEC and other official endpoints.
NEWS_OFFICIAL_USER_AGENT=ChartRadar/1.0 (https://your-domain.kr/contact)
# Optional server-only UUID allowlist for disposable shadow-mode end-to-end verification.
# Leave empty after the canary accounts are removed. Never add real beta users here.
PERPETUAL_REVENUE_CORE_CANARY_USER_IDS=
# Required with the canary allowlist. ISO timestamp no more than 24 hours ahead.
PERPETUAL_REVENUE_CORE_CANARY_EXPIRES_AT=
PRODUCT_ANALYTICS_HMAC_SECRET=
# Server-only UUID allowlist for staff/tester accounts. These events are always
# classified as internal and excluded from conversion cohorts.
PRODUCT_ANALYTICS_INTERNAL_USER_IDS=
# Server-only HMAC key for short-lived signed QA traffic. Use a different value
# from PRODUCT_ANALYTICS_HMAC_SECRET and keep both at least 32 characters long.
PRODUCT_ANALYTICS_QA_SECRET=
# Exact UUIDs of the 12 post-baseline UI-audit events. The release gate requires
# all 12 before the service-role-only backfill RPC may classify them as internal.
COIN_PRO_V2_INTERNAL_QA_EVENT_IDS=
# Comma-separated SHA-256 fingerprints from Google Play App Signing certificates.
# Use the Play App Signing certificate for production App Links, not only the upload certificate.
ANDROID_APP_LINK_SHA256_FINGERPRINTS=
# Server-only. Firebase Cloud Messaging HTTP v1 credentials for Android app push.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
